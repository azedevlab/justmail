    "@justmail/openapi": "workspace:*",
    "@justmail/plugin-sdk": "workspace:*",
    "@justmail/storage": "workspace:*",
    "@justmail/theme-engine": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.1.2",
    "ioredis": "^6.0.0",
    "ldapts": "^9.2.0",
