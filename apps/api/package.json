    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.8.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
