  "description": "JustMail control-plane API: REST, WebSocket, workers.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
